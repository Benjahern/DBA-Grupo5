# ── Entorno ──────────────────────────────────────────────────
ENVIRONMENT=development
NODE_ENV=development

# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=bda_lab1
POSTGRES_USER=bda_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ── MongoDB ──────────────────────────────────────────────────
MONGO_DB=bda_lab3
MONGO_USER=bda_user
MONGO_PASSWORD=CHANGE_ME
MONGO_PORT=27017
# Dentro de compose: "mongo". Para bootRun local fuera de compose: localhost
MONGO_HOST=mongo

# ── Backend (Spring Boot) ────────────────────────────────────
BACKEND_PORT=8080
BACKEND_URL=http://localhost:8080

# ── JWT propio ───────────────────────────────────────────────
# Secreto HS256: cambiar en producción. Mínimo 32 bytes (256 bits).
JWT_SECRET=dev-only-secret-key-must-be-at-least-32-bytes-long-aaaaaaaaaaaa
# Access token de 15 min, refresh de 30 días.
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000
# En dev (HTTP) cookies no requieren Secure=true; en prod (HTTPS) subir a true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# ── Admin inicial (sembrado por PasswordSeeder) ─────────────
ADMIN_EMAIL=admin@gmail.com
ADMIN_INITIAL_PASSWORD=Admin123!

# ── CORS (Control de acceso cross-origin) ────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true

# ── Frontend (Vite) ──────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
