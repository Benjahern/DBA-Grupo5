# El servidor de desarrollo de Vite detecta cambios en el volumen montado y
# recarga el navegado automáticamente sin necesidad de rebuild.

FROM node:22-alpine

WORKDIR /app

# Corepack viene pre-instalado en Node >= 16.13 y permite usar pnpm sin instalar nada global
RUN corepack enable

# Copiamos solo los manifiestos primero para aprovechar la caché de capas
COPY package.json pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

# El código fuente se monta como volumen en docker-compose (no se copia aquí)
# para que los cambios locales sean visibles de inmediato.

EXPOSE 5173

# --host  → escucha en 0.0.0.0 (necesario dentro del contenedor)
# --poll  → usa polling para detectar cambios en sistemas de archivos montados
CMD ["pnpm", "run", "dev", "--", "--host", "0.0.0.0"]
