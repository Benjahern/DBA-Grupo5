# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=bda_lab1
POSTGRES_USER=bda_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ── Backend (Spring Boot) ────────────────────────────────────
BACKEND_PORT=8080
SPRING_JPA_DDL_AUTO=validate

# ── Frontend (Vite) ──────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
